<?xml version="1.0" encoding="utf-8"?>
<!--
    يسمح هذا الملف بتحميل بثوث http:// (غير مشفرة)
    مطلوب لروابط IPTV مثل: http://xxx.cc:80/.../stream.m3u8
    ضعه في: app/src/main/res/xml/network_security_config.xml
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
